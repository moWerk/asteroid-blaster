[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-asteroid-blaster
Exec=sailfish-qml harbour-asteroid-blaster
Name=Blaster
Comment=A tilt controlled asteroid shooter

[X-Sailjail]
# Sandboxed. The game reads the accelerometer and keeps its scores in dconf
# (/apps/harbour-asteroid-blaster). Camera, not Sensors: the Jolla Store does
# not allow Sensors, and SailfishOS's Camera permission includes it (see
# /etc/sailjail/permissions/Camera.permission). The camera is never used.
OrganizationName=net.mowerk
ApplicationName=harbour-asteroid-blaster
Permissions=Camera

[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-asteroid-blaster
Exec=harbour-asteroid-blaster
Name=Blaster
Comment=A tilt controlled asteroid shooter

[X-Sailjail]
# Sandboxed. The game reads the accelerometer (Sensors) and writes only
# its own config directory, ~/.config/net.mowerk/harbour-asteroid-blaster/.
OrganizationName=net.mowerk
ApplicationName=harbour-asteroid-blaster
Permissions=Sensors
